  <diagram id="vision" name="Vision and scope">
    <mxGraphModel dx="1160" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="810" background="#F3F6F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="project" value="Intercom-Alpha / Product" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=15;fontColor=#286754;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="27" width="1080" height="24" as="geometry"/></mxCell>
      <mxCell id="title" value="Vision and scope" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=32;fontColor=#162824;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1080" height="42" as="geometry"/></mxCell>
      <mxCell id="subtitle" value="Help a group start talking and stay connected when mobile coverage drops." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=16;fontColor=#435951;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="97" width="1080" height="26" as="geometry"/></mxCell>
      <mxCell id="card0" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Primary user&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Riders and outdoor groups need short,&lt;br&gt;hands-free or low-glance communication.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card1" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Mobile product&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Android Compose and native iOS SwiftUI are&lt;br&gt;the primary experiences.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card2" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Release outcome&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;A mixed-phone group can set up offline and&lt;br&gt;recover from a dropped peer.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card3" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Core intercom&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Create or join, pick a channel, talk,&lt;br&gt;listen and see connection state.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card4" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Supporting tools&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Guarded SOS, group roster, radar, trail&lt;br&gt;files and repeater have dedicated homes.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card5" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Future fleet&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Basecamp dispatch and longer field soaks&lt;br&gt;follow measured mobile reliability.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card6" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Field constraints&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Gloves, sunlight, small screens, noisy&lt;br&gt;headsets and intermittent coverage.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card7" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Product boundary&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;The public site explains the app and links&lt;br&gt;to documentation.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card8" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Decision rule&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Add cockpit UI only when it helps a&lt;br&gt;frequent or time-critical task.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="516" width="336" height="160" as="geometry"/></mxCell>
