      <mxCell id="subtitle" value="Sequence work by what removes uncertainty for a rider and for the release." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=16;fontColor=#435951;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="97" width="1080" height="26" as="geometry"/></mxCell>
