      <mxCell id="source0" value="&lt;a href=&quot;https://github.com/Nownitya/Intercom-Alpha/blob/sprint/sprint-37-fleet-congestion-control/app/sharedUI/src/commonMain/kotlin/org/nowni/intercom_alpha/feature/home/MainCockpitScreen.kt&quot;&gt;MainCockpitScreen.kt&lt;/a&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=13;fontColor=#286754;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="734" width="530" height="22" as="geometry"/></mxCell>
