      <mxCell id="card8" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Keep scope visible&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Track evidence by platform and distinguish&lt;br&gt;source presence, simulation, real device&lt;br&gt;behavior and release status.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="516" width="336" height="160" as="geometry"/></mxCell>
