      <mxCell id="project" value="Intercom-Alpha / Product" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=15;fontColor=#286754;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="27" width="1080" height="24" as="geometry"/></mxCell>
      <mxCell id="title" value="Proposed app experience" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=32;fontColor=#162824;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1080" height="42" as="geometry"/></mxCell>
      <mxCell id="subtitle" value="Keep the voice controls stable and move setup, optional tools and details into predictable destinations." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=16;fontColor=#435951;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="97" width="1080" height="26" as="geometry"/></mxCell>
      <mxCell id="edge-0-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="card0" target="card1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-1-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="card1" target="card2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-3-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="card3" target="card4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-4-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="card4" target="card5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-6-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="card6" target="card7"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-7-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="card7" target="card8"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="card0" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Intercom&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Use group/channel, connection, speaker,&lt;br&gt;large momentary Talk and guarded SOS. Pair&lt;br&gt;critical color with text.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card1" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Group&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Create, join by QR or code, invite, view&lt;br&gt;roster and leave. Reachable under every&lt;br&gt;profile.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card2" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Tools and settings&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Tools owns messages, Radar, Trail and&lt;br&gt;Repeater. Settings owns Audio, Display,&lt;br&gt;Battery and Advanced.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card3" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Disconnected → listening&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Offer create/join. On success show the&lt;br&gt;actual group and active channel.&lt;br&gt;Distinguish waiting from connected.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card4" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Press → transmit → release&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Provide immediate transmission feedback.&lt;br&gt;Stop on interrupted gesture, backgrounding&lt;br&gt;or connection loss.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card5" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Reconnect → resume listening&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Keep the last group/channel visible,&lt;br&gt;explain the outage and return to listening&lt;br&gt;after recovery.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card6" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Channel and profile&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Use a picker for active channel; mark&lt;br&gt;monitored channels separately. Use&lt;br&gt;single-choice lists for profiles.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card7" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Optional display settings&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Use switches for meters, low-power UI and&lt;br&gt;shortcuts. Disabled shortcuts leave tools&lt;br&gt;and group actions reachable.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card8" value="&lt;div style=&quot;font-size:12px;color:#375AA1;font-weight:bold&quot;&gt;Proposed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Guarded SOS&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Confirm or cancel before sending, provide&lt;br&gt;an accessible equivalent and report sent&lt;br&gt;or failed state.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#E4E9F9;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="legend0" value="Present in source" style="rounded=1;html=1;align=left;spacingLeft=8;fillColor=#DCEDE7;strokeColor=none;fontColor=#286754;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="240" height="22" as="geometry"/></mxCell>
      <mxCell id="legend1" value="Runtime check needed" style="rounded=1;html=1;align=left;spacingLeft=8;fillColor=#FFF0D0;strokeColor=none;fontColor=#8A580A;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="295" y="702" width="240" height="22" as="geometry"/></mxCell>
