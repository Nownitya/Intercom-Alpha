      <mxCell id="legend3" value="Proposed" style="rounded=1;html=1;align=left;spacingLeft=8;fillColor=#E4E9F9;strokeColor=none;fontColor=#375AA1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="805" y="702" width="240" height="22" as="geometry"/></mxCell>
