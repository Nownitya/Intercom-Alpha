      <mxCell id="edge-5-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="card5" target="card6"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="card0" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;GSD defines scope&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Pick a phase and define requirements,&lt;br&gt;constraints, acceptance and test evidence.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card1" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Ralph implements one story&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Use the active sprint and atomic feature&lt;br&gt;branch. Start from the highest-priority&lt;br&gt;story still open.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card2" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Run verification gates&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Run Gradle tests and Android build; verify&lt;br&gt;iOS compilation and native UI on a&lt;br&gt;suitable host.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card3" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;OpenCodeReview&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Run preview and rule checks. Resolve&lt;br&gt;medium, high and critical findings and&lt;br&gt;repeat verification.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card4" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Integrate and record&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Merge to the sprint branch, update Ralph&lt;br&gt;tracker, progress and memory. Refresh&lt;br&gt;Graphify after code changes.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card5" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Validate milestone&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Reconcile the repository and Obsidian&lt;br&gt;roadmap. Separate simulation evidence from&lt;br&gt;phone and field results.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card6" value="&lt;div style=&quot;font-size:12px;color:#A23930;font-weight:bold&quot;&gt;Gap&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Current evidence&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Ralph records ICA-3701–3703 as passed;&lt;br&gt;SPRINT.md still says Ready. Obsidian&lt;br&gt;assigns Sprint 37 to basecamp dispatch.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#F9E2DE;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="516" width="336" height="160" as="geometry"/></mxCell>
