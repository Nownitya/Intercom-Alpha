  <diagram id="relay-recovery" name="Relay, congestion, and recovery">
    <mxGraphModel dx="1160" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="810" background="#F3F6F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="project" value="Intercom-Alpha / Engineering flows" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=15;fontColor=#286754;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="27" width="1080" height="24" as="geometry"/></mxCell>
      <mxCell id="title" value="Relay, congestion, and recovery" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=32;fontColor=#162824;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1080" height="42" as="geometry"/></mxCell>
      <mxCell id="subtitle" value="Track packet routing and the separate loop that should turn RF measurements into radio behavior." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=16;fontColor=#435951;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="97" width="1080" height="26" as="geometry"/></mxCell>
      <mxCell id="edge-0-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="card0" target="card1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-1-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="card1" target="card2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-3-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="card3" target="card4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-4-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="card4" target="card5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-6-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="card6" target="card7"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-7-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="card7" target="card8"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="edge-5-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#577168;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="card5" target="card6"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="card0" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;BLE-first send&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Use the local transport while the route is&lt;br&gt;suitable. Receiving peers check packet&lt;br&gt;novelty before forwarding.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card1" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Path deteriorates&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Shared link/failover policy can select a&lt;br&gt;cloud path where configured and reachable.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card2" value="&lt;div style=&quot;font-size:12px;color:#8A580A;font-weight:bold&quot;&gt;Runtime check needed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Return to BLE&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Exercise failed fallback, duplicate&lt;br&gt;delivery and recovery. Confirm no previous&lt;br&gt;PTT session resumes.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#FFF0D0;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card3" value="&lt;div style=&quot;font-size:12px;color:#8A580A;font-weight:bold&quot;&gt;Runtime check needed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Observe airtime and link&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Locate real occupancy, RSSI and&lt;br&gt;packet-loss inputs and distinguish missing&lt;br&gt;samples.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#FFF0D0;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card4" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Evaluate policy&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Shared congestion governor and PHY&lt;br&gt;switcher can produce throttling and PHY&lt;br&gt;decisions.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card5" value="&lt;div style=&quot;font-size:12px;color:#A23930;font-weight:bold&quot;&gt;Gap&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Apply on radio&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Android production attachment and actual&lt;br&gt;PHY application were not established by&lt;br&gt;the source audit. Confirm platform&lt;br&gt;support.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#F9E2DE;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card6" value="&lt;div style=&quot;font-size:12px;color:#8A580A;font-weight:bold&quot;&gt;Runtime check needed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Observe applied result&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Separate requested mode, applied mode and&lt;br&gt;unsupported state. Validate against device&lt;br&gt;observations.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#FFF0D0;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card7" value="&lt;div style=&quot;font-size:12px;color:#A23930;font-weight:bold&quot;&gt;Gap&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Expose in UI&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Bridge snapshots and Compose indicators&lt;br&gt;exist. Empty diagnostics handlers and iOS&lt;br&gt;observer reachability remain gaps.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#F9E2DE;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card8" value="&lt;div style=&quot;font-size:12px;color:#8A580A;font-weight:bold&quot;&gt;Runtime check needed&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Prove end to end&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Capture radio evidence on both phone&lt;br&gt;platforms and run the outstanding density&lt;br&gt;simulation under agreed node count.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#FFF0D0;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="legend0" value="Present in source" style="rounded=1;html=1;align=left;spacingLeft=8;fillColor=#DCEDE7;strokeColor=none;fontColor=#286754;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="240" height="22" as="geometry"/></mxCell>
      <mxCell id="legend1" value="Runtime check needed" style="rounded=1;html=1;align=left;spacingLeft=8;fillColor=#FFF0D0;strokeColor=none;fontColor=#8A580A;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="295" y="702" width="240" height="22" as="geometry"/></mxCell>
      <mxCell id="legend2" value="Gap" style="rounded=1;html=1;align=left;spacingLeft=8;fillColor=#F9E2DE;strokeColor=none;fontColor=#A23930;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="702" width="240" height="22" as="geometry"/></mxCell>
      <mxCell id="legend3" value="Proposed" style="rounded=1;html=1;align=left;spacingLeft=8;fillColor=#E4E9F9;strokeColor=none;fontColor=#375AA1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="805" y="702" width="240" height="22" as="geometry"/></mxCell>
      <mxCell id="source0" value="&lt;a href=&quot;https://github.com/Nownitya/Intercom-Alpha/blob/sprint/sprint-37-fleet-congestion-control/docs/ROADMAP.md&quot;&gt;ROADMAP.md&lt;/a&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=13;fontColor=#286754;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="734" width="530" height="22" as="geometry"/></mxCell>
      <mxCell id="source1" value="&lt;a href=&quot;https://github.com/Nownitya/Intercom-Alpha/blob/sprint/sprint-37-fleet-congestion-control/tasks/ralph/prd.json&quot;&gt;prd.json&lt;/a&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=13;fontColor=#286754;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="734" width="530" height="22" as="geometry"/></mxCell>
      <mxCell id="source2" value="&lt;a href=&quot;https://github.com/Nownitya/Intercom-Alpha/blob/sprint/sprint-37-fleet-congestion-control/docs/testing/field-reports/RangeBenchmark.md&quot;&gt;RangeBenchmark.md&lt;/a&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontSize=13;fontColor=#286754;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="756" width="530" height="22" as="geometry"/></mxCell>
    </root></mxGraphModel>
