      <mxCell id="legend2" value="Gap" style="rounded=1;html=1;align=left;spacingLeft=8;fillColor=#F9E2DE;strokeColor=none;fontColor=#A23930;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="702" width="240" height="22" as="geometry"/></mxCell>
