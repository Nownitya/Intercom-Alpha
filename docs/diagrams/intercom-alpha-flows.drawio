      <mxCell id="card0" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Android&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Compose cockpit and foreground service.&lt;br&gt;Android bridge connects to platform BLE&lt;br&gt;and audio.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card1" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Shared Kotlin&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Audio, channel/group, routing,&lt;br&gt;deduplication, encryption, telemetry,&lt;br&gt;mapping and relay coordination.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card2" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;iOS&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Native SwiftUI through IntercomBridge and&lt;br&gt;cancellable observation; platform&lt;br&gt;CoreBluetooth and AVAudioEngine.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="144" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card3" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Local fleet&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Peer devices discover and exchange packets&lt;br&gt;over platform GATT transport.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card4" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Signaling contract&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;The :core module defines shared signaling&lt;br&gt;messages; the client uses the Ktor&lt;br&gt;signaling path.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card5" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Cloud relay&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;The :server module exposes /ws/intercom.&lt;br&gt;Cloud fallback requires connectivity and&lt;br&gt;field verification.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="330" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card6" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Local processing&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Platform-specific capture and routing feed&lt;br&gt;common audio and packet code.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="40" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card7" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Support modules&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Trail, convoy telemetry and repeater logic&lt;br&gt;augment the voice experience.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="412" y="516" width="336" height="160" as="geometry"/></mxCell>
      <mxCell id="card8" value="&lt;div style=&quot;font-size:12px;color:#286754;font-weight:bold&quot;&gt;Present in source&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;margin-top:11px&quot;&gt;Additional clients&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#435951;margin-top:8px&quot;&gt;Desktop and browser use Compose. Mobile&lt;br&gt;BLE and headset behavior needs validation&lt;br&gt;on phones.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fillColor=#DCEDE7;strokeColor=none;fontColor=#162824;" vertex="1" parent="1"><mxGeometry x="784" y="516" width="336" height="160" as="geometry"/></mxCell>
